# =============================================================================
# Oura Dashboard Configuration
# =============================================================================

# Your Oura Personal Access Token (required)
OURA_TOKEN=your_personal_access_token_here

# =============================================================================
# Public Website Mode (for henderburgh.com style deployments)
# =============================================================================
PUBLIC_MODE=false
DISPLAY_NAME=Henderburgh
SITE_NAME=Henderburgh
SITE_URL=https://henderburgh.com
OURA_DAYS=14
CACHE_TTL_SECONDS=180
AUTO_REFRESH_SECONDS=300

# =============================================================================
# Xbox Live Status (OpenXBL API)
# =============================================================================
XBL_API_KEY=your_openxbl_api_key_here
XBL_GAMERTAG=your_gamertag_here
# XBL_XUID=optional_xuid_to_bypass_gamertag_lookup

# Admin Token (for protected actions — used once via /api/auth/unlock, stored as HttpOnly cookie)
ADMIN_TOKEN=your_admin_token_here

# =============================================================================
# Home Assistant Integration (private / local LAN only, PUBLIC_MODE=false)
# =============================================================================
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_home_assistant_long_lived_token_here
