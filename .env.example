# =============================================================================
# Oura Dashboard Configuration
# =============================================================================

# Your Oura Personal Access Token (required)
OURA_TOKEN=your_personal_access_token_here

# =============================================================================
# Public Website Mode (for henderburgh.com style deployments)
# =============================================================================
# Set to true when deploying publicly. This removes the setup screen,
# disables manual refresh (to protect quota), and enables longer caching.
PUBLIC_MODE=false

# How your name appears on the public site
DISPLAY_NAME=Henderburgh

# Branding
SITE_NAME=Henderburgh
SITE_URL=https://henderburgh.com

# How many days of history to load
OURA_DAYS=14

# Cache duration in seconds (longer = fewer Oura API calls)
# Recommended: 600 (10 min) when PUBLIC_MODE=true
CACHE_TTL_SECONDS=180

# Client-side auto-refresh interval (in seconds)
# 0 = disabled, 300 = every 5 minutes (recommended for public)
# In PUBLIC_MODE this defaults to 300 if not set.
AUTO_REFRESH_SECONDS=300

# =============================================================================
# Xbox Live Status (OpenXBL API) - REQUIRED TO MAKE XBOX CARD WORK
# =============================================================================
# Get your free API key at https://xbl.io/ (create an app in their console).
#
# === LOCAL DEVELOPMENT (.env) ===
# 1. Add or update these in your .env file:
#    XBL_API_KEY=your_real_key_from_xbl.io
#    XBL_GAMERTAG=your_xbox_gamertag
#    # Optional: XBL_XUID=your_xuid (to bypass gamertag lookup if profile call fails)
# 2. Restart the local dev server.
# 3. The Xbox card on the homepage will now fetch real data.
#
# === PRODUCTION (https://henderburgh.com on Railway) ===
# 1. In Railway dashboard for this project, go to Variables.
# 2. Add these (they override .env):
#    XBL_API_KEY = your_real_key_from_xbl.io
#    XBL_GAMERTAG = your_xbox_gamertag
#    # XBL_XUID = your_xuid (optional)
# 3. Deploy/redeploy.
#
# Test manually (IMPORTANT - validate your key first):
#   curl -H "X-Authorization: YOUR_KEY" -H "Accept: application/json" \
#     "https://xbl.io/api/v2/account"
# This MUST return HTTP 200 (not 401 "Invalid API key."). If not, the key is wrong - go back to xbl.io console and copy the correct API key for your app (not App ID, Client ID, or secret).
#
# Then test gamertag:
#   curl -H "X-Authorization: YOUR_KEY" -H "Accept: application/json" \
#     "https://xbl.io/api/v2/player/gamertag/YOUR_GAMERTAG"
# Expect 200 with xuid.
#
# If profile/gamertag lookup fails but you have the XUID from xbl.io console, set XBL_XUID instead.
XBL_API_KEY=your_openxbl_api_key_here
XBL_GAMERTAG=your_gamertag_here

# Admin Token (for protected actions like deleting blog messages)
# =============================================================================
# This token is required to delete messages on the /blog page.
# Set a strong secret value here (and the same value in Railway).
ADMIN_TOKEN=your_admin_token_here
